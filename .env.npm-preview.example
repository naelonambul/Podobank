# Copy to .env.npm-preview and replace every placeholder before starting the preview.
APP_ENV=development
MARIADB_DATABASE=podobank_dev
MARIADB_USER=podobank
MARIADB_PASSWORD=replace-with-existing-development-db-password
COMPOSE_DATABASE_URL=mysql+pymysql://${MARIADB_USER}:${MARIADB_PASSWORD}@db:3306/${MARIADB_DATABASE}
API_ORIGIN=https://podobank-api.i234.workers.dev
KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
KAKAO_REDIRECT_URI=https://podobank.i234.workers.dev/auth/kakao/callback
JWT_SECRET=replace-with-a-unique-random-64-hex-secret
JWT_LIFETIME_MINUTES=120
AUTH_COOKIE_SECURE=true
FRONTEND_ORIGINS=https://podobank.i234.workers.dev
BANK_EMPLOYEE_PHONE=01000000002
BANK_EMPLOYEE_PASSWORD=replace-with-a-unique-strong-employee-password
DEMO_CUSTOMER_PASSWORD=replace-with-a-unique-strong-customer-password
NPM_DOCKER_NETWORK=nginx-proxy-manager
