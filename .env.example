# Sample local development settings. Copy this file to .env and adjust as needed.
APP_ENV=development
API_PORT=8000
DB_PORT=3306
FRONTEND_PORT=8081
MARIADB_DATABASE=podobank_dev
MARIADB_USER=podobank
MARIADB_PASSWORD=podobank-test
MARIADB_ROOT_PASSWORD=podobank-dev-root-password
DATABASE_URL=mysql+pymysql://podobank:podobank-test@127.0.0.1:3306/podobank_dev
COMPOSE_DATABASE_URL=mysql+pymysql://${MARIADB_USER}:${MARIADB_PASSWORD}@db:3306/${MARIADB_DATABASE}
API_ORIGIN=http://localhost:8000
VITE_API_ORIGIN=http://localhost:8000
KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:8081/auth/kakao/callback
JWT_SECRET=development-only-change-this-secret-32-chars
JWT_LIFETIME_MINUTES=120
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:8081,http://localhost:5173
BANK_EMPLOYEE_PHONE=01000000002
BANK_EMPLOYEE_PASSWORD=local-demo-employee-password
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=development-only-change-this-password
