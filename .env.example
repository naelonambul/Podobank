# Compose host settings for the local FastAPI container.
APP_ENV=development
API_PORT=8000
JWT_SECRET=replace-with-a-local-development-secret
SESSION_TTL_SECONDS=86400
STAFF_INITIAL_PHONE=01099990000
STAFF_INITIAL_PASSWORD=replace-with-a-local-demo-password
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
