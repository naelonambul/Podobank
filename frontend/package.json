{
  "name": "podobank-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.13.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run test:unit"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "vite": "8.3.5"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
